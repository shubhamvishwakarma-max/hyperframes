{
  "name": "doubletick-piramal-leadgen",
  "version": "1.0.0",
  "private": true,
  "description": "30s 1:1 lead-gen film — Piramal Finance × DoubleTick (Remotion)",
  "type": "module",
  "scripts": {
    "setup:fonts": "node scripts/copyFonts.mjs",
    "narration": "tsx scripts/generateNarration.ts",
    "audio": "python3 scripts/generate_audio.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PiramalLeadGen out/raw.mp4 --timeout=120000",
    "master": "bash scripts/master.sh",
    "build": "npm run setup:fonts && npm run audio && npm run render && npm run master"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/fonts": "4.0.290",
    "geist": "^1.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "18.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
